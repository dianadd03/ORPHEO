@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<h2 class="orpheo-page-title mb-4">Log in to Orpheo</h2>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="orpheo-card p-4">

            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 role="alert"></div>

            <form id="account" method="post">

                <!-- EMAIL -->
                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email"
                           class="form-control orpheo-input"
                           autocomplete="username"
                           placeholder="email@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- PASSWORD -->
                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password"
                           class="form-control orpheo-input"
                           autocomplete="current-password"
                           placeholder="Password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- REMEMBER -->
                <div class="form-check mb-4">
                    <input class="form-check-input"
                           asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe"
                           class="form-check-label">
                        Remember me
                    </label>
                </div>

                <!-- ACTION -->
                <button type="submit"
                        id="login-submit"
                        class="btn-orpheo w-100 mb-3">
                    Log in
                </button>

                <!-- LINKS -->
                <div class="text-center">
                    <p class="mb-1">
                        <a asp-page="./ForgotPassword">
                            Forgot your password?
                        </a>
                    </p>
                    <p class="mb-1">
                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            Create a new account
                        </a>
                    </p>
                    <p>
                        <a asp-page="./ResendEmailConfirmation">
                            Resend email confirmation
                        </a>
                    </p>
                </div>
            </form>
        </div>

        <!-- EXTERNAL LOGIN -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="orpheo-card p-4 mt-4 text-center">
                <h5 class="mb-3">Or log in with</h5>

                <form asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn-cancel"
                                    name="provider"
                                    value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            </div>
        }

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
