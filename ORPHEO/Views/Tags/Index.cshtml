@using Orpheo.Models

@{
    var tags = ViewBag.Tags as IEnumerable<Tag>;
}

<h2>Lista tagurilor</h2>

@if (User.IsInRole("Admin"))
{
    <a asp-action="New" class="btn btn-primary mb-3">Creează tag</a>
}

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType">@ViewBag.Message</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nume</th>
            <th>Nr. melodii</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in tags)
        {
            <tr>
                <td>@tag.Name</td>
                <td>@tag.SongTags?.Count()</td>
                <td>
                    <a asp-action="Show" asp-route-id="@tag.Id" class="btn btn-info btn-sm">Show</a>
                </td>
            </tr>
        }
    </tbody>
</table>
