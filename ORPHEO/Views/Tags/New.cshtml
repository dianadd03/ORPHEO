@model Orpheo.Models.Tag

@{
    ViewData["Title"] = "Create tag";
}

<h2 class="orpheo-page-title mb-4">Create tag</h2>

<!-- ALERT / VALIDATION -->
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-controller="Tags"
      asp-action="New"
      method="post"
      class="orpheo-form">

    <!-- NAME -->
    <div class="mb-4">
        <label asp-for="Name" class="form-label">
            Tag name
        </label>
        <input asp-for="Name"
               class="form-control orpheo-input"
               placeholder="e.g. chill, energetic, sad" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex gap-3">
        <button type="submit" class="btn-orpheo">
            <i class="bi bi-check-circle me-1"></i>
            Create
        </button>

        <a asp-action="Index" class="btn-cancel">
            Cancel
        </a>
    </div>
</form>
