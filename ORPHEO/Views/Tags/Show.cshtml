@model Orpheo.Models.Tag

@{
    ViewData["Title"] = Model.Name;
}

<h2 class="orpheo-page-title mb-2">
    #@Model.Name
</h2>

<!-- ADMIN ACTIONS -->
@if (User.IsInRole("Admin"))
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-orpheo">
            <i class="bi bi-pencil-square me-1"></i>
            Edit
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn-cancel">
            <i class="bi bi-trash me-1"></i>
            Delete
        </a>
    </div>
}

<hr class="mb-4" />

<h4 class="mb-3">Songs using this tag</h4>

@if (Model.SongTags.Any())
{
    <div class="d-flex flex-column gap-2">
        @foreach (var st in Model.SongTags)
        {
            <div class="orpheo-card p-3 d-flex justify-content-between align-items-center">

                <span>
                    @st.Song.Title
                </span>

                <a asp-controller="Songs"
                   asp-action="Show"
                   asp-route-id="@st.Song.Id"
                   class="btn-orpheo-play">
                    Open
                </a>

            </div>
        }
    </div>
}
else
{
    <p class="text-muted">
        There are no songs using this tag.
    </p>
}

<div class="mt-4">
    <a asp-action="Index" class="btn-cancel">
        Back to tags
    </a>
</div>
