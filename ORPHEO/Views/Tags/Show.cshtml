@model Orpheo.Models.Tag

<h2>@Model.Name</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"> <i class="bi bi-pencil-square"></i></a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button class="btn btn-danger"><i class="bi bi-trash-fill"></i></button>
        </form>
        </div>
    </p>
}

<hr />

<h4>Songs using this tag</h4>

@if (Model.SongTags.Any())
{
    <ul class="list-group">
        @foreach (var st in Model.SongTags)
        {
            <li class="list-group-item">@st.Song.Title</li>
        }
    </ul>
}
else
{
    <p><em>There are no songs using this tag.</em></p>
}

<br />
<a asp-action="Index" class="btn btn-secondary">Back</a>
