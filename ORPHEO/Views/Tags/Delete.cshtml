@model Orpheo.Models.Tag

<h2>Delete tag</h2>

<p>Are you sure you want to delete this tag <strong>@Model.Name</strong>?</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger">Deleye</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
