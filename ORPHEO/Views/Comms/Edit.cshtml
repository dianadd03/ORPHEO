@model Orpheo.Models.Comm

<h2>Editare comentariu</h2>
<br />

<form asp-action="Edit" asp-controller="Comms" asp-route-id="@Model.Id" method="post">

    <div class="form-group">
        <label asp-for="Text" class="form-label">Conținut comentariu</label>
        <br />
        <textarea asp-for="Text" class="form-control"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <br /><br />

    <button class="btn btn-primary" type="submit">Editează comentariul</button>

</form>
