@model Orpheo.Models.Comm

<h2>Edit comment</h2>
<br />

<form asp-action="Edit" asp-controller="Comms" asp-route-id="@Model.Id" method="post">

    <div class="form-group">
        <label asp-for="Text" class="form-label">Content</label>
        <br />
        <textarea asp-for="Text" class="orpheo-input"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <br /><br />

    <button class="btn-orpheo" type="submit">Edit</button>

</form>
