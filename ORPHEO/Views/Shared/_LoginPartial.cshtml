@using Microsoft.AspNetCore.Identity
@using Orpheo.Models
@using Orpheo.Data

@inject ApplicationDbContext _context
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">

    @* ADMIN *@
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item d-flex align-items-center">
            <img src="~/images/administrator.png" class="orpheo-icon me-1" />
        </li>

        <li class="nav-item">
            <a class="nav-link orpheo-link"
               asp-controller="RoleRequests"
               asp-action="PendingRequests">
                Role Requests
            </a>
        </li>
    }

    @* ARTIST *@
    @if (User.IsInRole("Artist"))
    {
        <li class="nav-item d-flex align-items-center">
            <img src="~/images/artist.png" class="orpheo-icon me-1" />
        </li>
    }

    @* USER *@
    @if (User.IsInRole("User"))
    {
        <li class="nav-item d-flex align-items-center">
            <img src="~/images/music.png" class="orpheo-icon me-1" />
        </li>
    }

    @* AUTHENTICATED *@
    @if (User.Identity!.IsAuthenticated)
    {
        var loggedUser = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            <a class="nav-link orpheo-link"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Manage">
                Hello @loggedUser?.Name!
            </a>
        </li>

        <li class="nav-item">
            <a asp-area="Identity"
               asp-page="/Account/Logout"
               class="nav-link orpheo-link">
                Logout
            </a>
        </li>

    }
    else
    {
        <li class="nav-item">
            <a class="nav-link orpheo-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link orpheo-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }

</ul>
