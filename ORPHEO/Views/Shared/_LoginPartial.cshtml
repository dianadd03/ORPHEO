@using Microsoft.AspNetCore.Identity
@using Orpheo.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">

    @if (User.IsInRole("Admin"))
    {

        <li class="nav-item d-flex align-items-center">
            <img src="~/images/administrator.png" style="height:24px;" class="me-1" />
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="RoleRequests"
               asp-action="PendingRequests">
                Role Requests
            </a>
        </li>
    }


    @if (SignInManager.IsSignedIn(User))
    {

        var currentUser = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(currentUser);



        if (roles.Contains("User"))
        {

            <li class="nav-item d-flex align-items-center">
                <img src="~/images/music.png" style="height:24px;" class="me-1" />
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-controller="RoleRequests"
                   asp-action="RequestArtistRole">
                    Request Artist Role
                </a>
            </li>
        }

        if(roles.Contains("Artist"))
        {
            <li class="nav-item d-flex align-items-center">
                <img src="~/images/artist.png" style="height:24px;" class="me-1" />
            </li>
        }



        @using Microsoft.AspNetCore.Identity
    @inject UserManager<ApplicationUser> UserManager

    @if (User.Identity.IsAuthenticated)
        {
            var loggedUser = await UserManager.GetUserAsync(User);

            <li class="nav-item">
                <a class="nav-link text-dark"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index"
                   title="Manage">
                    Hello @loggedUser.Name!
                </a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

