@model Orpheo.Models.SessionRoom

@{
    ViewData["Title"] = "Create Session Room";
}

<h2 class="orpheo-page-title mb-4">Create session room</h2>

<!-- ALERT -->
@if (ViewBag.Message != null)
{
    <div class="orpheo-alert @ViewBag.AlertType">
        @ViewBag.Message
    </div>
}

<form method="post" class="orpheo-form">

    <!-- PLAYLIST -->
    <div class="mb-4">
        <label class="form-label">Select playlist</label>
        <select asp-for="PlaylistId"
                asp-items="ViewBag.Playlists"
                class="form-control orpheo-select">
        </select>
        <span asp-validation-for="PlaylistId" class="text-danger"></span>
    </div>

    <!-- NAME -->
    <div class="mb-4">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control orpheo-input" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex gap-3">
        <button type="submit" class="btn-orpheo">
            Create
        </button>

        <a asp-action="Index" class="btn-cancel">
            Cancel
        </a>
    </div>

</form>
