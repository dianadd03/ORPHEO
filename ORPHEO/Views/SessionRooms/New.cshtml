@{
    ViewData["Title"] = "SessionRooms";
}
@using Orpheo.Data
@model Orpheo.Models.SessionRoom

<h2 class="mb-4">Add a SessionRoom</h2>

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}

<form method="post">

    <div class="form-group">
        <label>Select playlist</label>
        <select asp-for="PlaylistId"
                class="form-control"
                asp-items="ViewBag.Playlists">
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Room Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success mt-4">
        Save SessionRoom
    </button>

</form>


