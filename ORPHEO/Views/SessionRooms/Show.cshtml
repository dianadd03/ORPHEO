@model Orpheo.Models.SessionRoom
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    bool isHost = Model.HostUserId == currentUserId;
    bool isAdmin = User.IsInRole("Admin");
}

<h2 class="orpheo-page-title mb-1">@Model.Name</h2>
<p class="text-muted mb-4">
    Playlist: <strong>@Model.Playlist?.Name</strong>
</p>

<!-- ALERT -->
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}

<!-- PLAYER -->
<div class="orpheo-card p-4 mb-4">

    <div class="d-flex align-items-center gap-3 mb-3">

        <button class="btn-orpheo-play" id="playPauseBtn">
            <i class="bi bi-play-fill" id="playIcon" style="font-size:28px;"></i>
        </button>

        <button class="btn-cancel" id="prevBtn">
            <i class="bi bi-skip-start-fill"></i>
        </button>

        <button class="btn-cancel" id="nextBtn">
            <i class="bi bi-skip-end-fill"></i>
        </button>

        <span id="currentSong" class="ms-3 fw-bold"></span>
    </div>

    <input type="range"
           id="progressBar"
           min="0"
           max="100"
           value="0"
           class="form-range" />

    <audio id="audioPlayer"></audio>
</div>

<!-- HOST ACTIONS -->
@if (isHost || isAdmin)
{
    <div class="d-flex gap-3 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-orpheo">
            <i class="bi bi-pencil-square me-1"></i>
            Edit room
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn-cancel">
            <i class="bi bi-trash me-1"></i>
            Delete
        </a>
    </div>
}

<!-- ADD PARTICIPANT -->
@if (isHost)
{
    <div class="orpheo-card p-4 mb-4">
        <h5 class="mb-3">Add participant</h5>

        <form asp-action="AddParticipant" method="post" class="d-flex gap-2">
            <input type="hidden" name="roomId" value="@Model.Id" />

            <input type="text"
                   name="userCode"
                   class="form-control orpheo-input"
                   placeholder="Enter user code"
                   maxlength="8"
                   required />

            <button type="submit" class="btn-orpheo">
                Add
            </button>
        </form>
    </div>
}

<!-- PARTICIPANTS -->
<div class="orpheo-card p-4 mb-4">
    <h5 class="mb-3">
        Participants (@Model.SessionRoomUsers.Count)
    </h5>

    <div class="d-flex flex-column gap-2">
        @foreach (var sru in Model.SessionRoomUsers)
        {
            <div class="d-flex justify-content-between align-items-center">
                <span>@sru.User?.UserName</span>

                @if (sru.UserId == Model.HostUserId)
                {
                    <span class="orpheo-tag">Host</span>
                }
            </div>
        }
    </div>
</div>

<!-- LEAVE -->
@if (!isAdmin && !isHost)
{
    <form asp-action="Leave"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Are you sure you want to leave this session room?');">
        <button class="btn-cancel mb-4">
            Leave session room
        </button>
    </form>
}

<!-- SONGS -->
<h4 class="mb-3">Songs in playlist</h4>

@if (Model.Playlist?.PlaylistSongs.Any() == true)
{
    <div class="d-flex flex-column gap-2">
        @foreach (var ps in Model.Playlist.PlaylistSongs)
        {
            <div class="orpheo-card p-3 d-flex justify-content-between align-items-center song-item"
                 data-url="@ps.Song.Url"
                 data-title="@ps.Song.Title">

                <span>@ps.Song.Title</span>

                <button class="btn-orpheo-play playThisBtn">
                    <i class="bi bi-play-fill"></i>
                </button>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">This playlist has no songs.</p>
}

<!-- SIGNALR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const roomId = @Model.Id;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/sessionRoomHub")
        .withAutomaticReconnect()
        .build();

    connection.start().then(() => {
        connection.invoke("JoinRoom", roomId);
    });

    connection.on("PlaySong", (songIndex, time) => {
        if (songIndex !== index) {
            loadSong(songIndex, false);
        }
        player.currentTime = time;
        player.play();
        playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
    });

    connection.on("PauseSong", (time) => {
        player.currentTime = time;
        player.pause();
        playIcon.classList.replace("bi-pause-fill", "bi-play-fill");
    });

    connection.on("SeekSong", (time) => {
        player.currentTime = time;
    });
</script>

<script>
    const player = document.getElementById("audioPlayer");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const playIcon = document.getElementById("playIcon");
    const currentSongLabel = document.getElementById("currentSong");
    const progressBar = document.getElementById("progressBar");
    const nextBtn = document.getElementById("nextBtn");
    const prevBtn = document.getElementById("prevBtn");

    const songs = Array.from(document.querySelectorAll(".song-item")).map(item => ({
        url: item.dataset.url,
        title: item.dataset.title
    }));

    let index = 0;

    function loadSong(i, broadcast = true) {
        index = i;
        player.src = songs[i].url;
        currentSongLabel.innerText = songs[i].title;

        if (broadcast) {
            player.play();
            playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
            connection.invoke("PlaySong", roomId, index, player.currentTime);
        }
    }

    playPauseBtn.onclick = () => {
        if (!player.src) {
            loadSong(0);
            return;
        }

        if (player.paused) {
            player.play();
            playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
            connection.invoke("PlaySong", roomId, index, player.currentTime);
        } else {
            player.pause();
            playIcon.classList.replace("bi-pause-fill", "bi-play-fill");
            connection.invoke("PauseSong", roomId, player.currentTime);
        }
    };

    nextBtn.onclick = () => {
        index = (index + 1) % songs.length;
        loadSong(index);
    };

    prevBtn.onclick = () => {
        index = (index - 1 + songs.length) % songs.length;
        loadSong(index);
    };

    player.ontimeupdate = () => {
        if (!isNaN(player.duration)) {
            progressBar.value = (player.currentTime / player.duration) * 100;
        }
    };

    progressBar.oninput = () => {
        const newTime = (progressBar.value / 100) * player.duration;
        player.currentTime = newTime;
        connection.invoke("SeekSong", roomId, newTime);
    };

    document.querySelectorAll(".playThisBtn").forEach((btn, i) => {
        btn.onclick = () => loadSong(i);
    });
</script>
