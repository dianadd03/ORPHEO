@model Orpheo.Models.SessionRoom 
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager


<h2>@Model.Name - @Model.HostUser</h2>
<h4>@Model.Playlist.Name</h4>

@if (TempData["message"] != null)
{
    <div class="alert @TempData["messageType"] mt-3">
        @TempData["message"]
    </div>
}


<!-- audio player -->
<div class="card p-3 mb-4">
    <div class="d-flex align-items-center gap-3">

        <!-- play/pause -->
        <button class="btn btn-primary" id="playPauseBtn">
            <i class="bi bi-play-fill" id="playIcon" style="font-size: 28px;"></i>
        </button>

        <!-- inapoi -->
        <button class="btn btn-outline-secondary" id="prevBtn">
            <i class="bi bi-skip-start-fill" style="font-size: 24px;"></i>
        </button>

        <!-- urm -->
        <button class="btn btn-outline-secondary" id="nextBtn">
            <i class="bi bi-skip-end-fill" style="font-size: 24px;"></i>
        </button>

        <span id="currentSong" class="ms-3 fw-bold"></span>
    </div>

    <!-- linia de redare -->
    <input type="range" id="progressBar" min="0" max="100" value="0"
           class="form-range mt-3" />

    <audio id="audioPlayer"></audio>
</div>

@if (User.IsInRole("Admin") ||
    Model.HostUserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
{
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit session room
    </a>
}

@if (User.IsInRole("Admin") ||
    Model.HostUserId == UserManager.GetUserId(User))
{
    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Delete session room
    </a>
}

@if (Model.HostUserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
{
    <form asp-action="AddParticipant" method="post" class="d-flex gap-2 mt-3">
        <input type="hidden" name="roomId" value="@Model.Id" />

        <input type="text"
               name="userCode"
               class="form-control"
               placeholder="Enter user code"
               maxlength="8"
               required />

        <button type="submit" class="btn btn-success">
            Add user
        </button>
    </form>
}

<div class="dropdown mt-3">
    <button class="btn btn-outline-secondary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        👥 Participants (@Model.SessionRoomUsers.Count)
    </button>

    <ul class="dropdown-menu">
        @foreach (var sru in Model.SessionRoomUsers)
        {
            <li class="dropdown-item d-flex justify-content-between align-items-center">
                <span>@sru.User.UserName</span>

                @if (sru.UserId == Model.HostUserId)
                {
                    <span class="badge bg-primary">Host</span>
                }
            </li>
        }
    </ul>
</div>
<br></br>

@if (!User.IsInRole("Admin") &&
    Model.HostUserId != User.FindFirstValue(ClaimTypes.NameIdentifier))
{
    <form asp-action="Leave"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Are you sure you want to leave this session room?');">
        <button class="btn btn-danger">
            Leave session room
        </button>
    </form>
}


<!-- melodii -->
<h4>Songs in this playlist:</h4>
<ul class="list-group">
    @foreach (var ps in Model.Playlist.PlaylistSongs)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center song-item"
            data-url="@ps.Song.Url" data-title="@ps.Song.Title">

            <span>@ps.Song.Title</span>

            <button class="btn btn-success btn-sm playThisBtn">
                <i class="bi bi-play-fill"></i>
            </button>
        </li>
    }
</ul>

<script>
    const player = document.getElementById("audioPlayer");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const playIcon = document.getElementById("playIcon");
    const currentSongLabel = document.getElementById("currentSong");
    const progressBar = document.getElementById("progressBar");
    const nextBtn = document.getElementById("nextBtn");
    const prevBtn = document.getElementById("prevBtn");

    // Construim playlistul
    const songs = Array.from(document.querySelectorAll(".song-item")).map(item => ({
        url: item.dataset.url,
        title: item.dataset.title
    }));

    let index = 0;

    function loadSong(i) {
        index = i;
        player.src = songs[i].url;
        currentSongLabel.innerText = songs[i].title;
        player.play();
        playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
    }

    playPauseBtn.onclick = () => {
        if (player.paused) {
            player.play();
            playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
        } else {
            player.pause();
            playIcon.classList.replace("bi-pause-fill", "bi-play-fill");
        }
    };

    nextBtn.onclick = () => {
        index = (index + 1) % songs.length;
        loadSong(index);
    };

    prevBtn.onclick = () => {
        index = (index - 1 + songs.length) % songs.length;
        loadSong(index);
    };

    player.onended = () => {
        index = (index + 1) % songs.length;
        loadSong(index);
    };

    player.ontimeupdate = () => {
        if (!isNaN(player.duration)) {
            progressBar.value = (player.currentTime / player.duration) * 100;
        }
    };

    progressBar.oninput = () => {
        player.currentTime = (progressBar.value / 100) * player.duration;
    };

    document.querySelectorAll(".playThisBtn").forEach((btn, i) => {
        btn.onclick = () => {
            loadSong(i);
        };
    });

    // incepem cu primul
    loadSong(0);
</script>

