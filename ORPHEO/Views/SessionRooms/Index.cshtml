@{
    ViewData["Title"] = "Session Rooms";
}

<h2 class="orpheo-page-title mb-4">Session Rooms</h2>

<!-- ALERT -->
@if (ViewBag.Message != null)
{
    <div class="orpheo-alert @ViewBag.AlertType">
        @ViewBag.Message
    </div>
}

<!-- ADD BUTTON -->
<a asp-controller="SessionRooms"
   asp-action="New"
   class="btn-orpheo mb-4">
    <i class="bi bi-plus-circle me-1"></i>
    Create session room
</a>
<br />
<br />

@if (((IEnumerable<Orpheo.Models.SessionRoom>)ViewBag.SessionRooms).Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var sr in ViewBag.SessionRooms)
        {
            <div class="orpheo-card d-flex justify-content-between align-items-center p-4">

                <!-- LEFT -->
                <div class="d-flex align-items-center gap-3">
                    <img src="~/images/people.png"
                         class="orpheo-icon"
                         alt="participants" />

                    <div>
                        <h5 class="mb-1">@sr.Name</h5>
                        <small class="text-muted">
                            Host: @sr.HostUser?.Email
                        </small>
                    </div>
                </div>

                <!-- RIGHT -->
                <a asp-action="Show"
                   asp-route-id="@sr.Id"
                   class="btn-orpheo-play">
                    Open
                </a>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">
        There are no session rooms yet.
    </p>
}
