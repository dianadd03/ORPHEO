@{
    ViewData["Title"] = "SessionRooms";
}
@using Orpheo.Data

<h2 class="mb-4">All SessionRooms</h2>

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}

<a asp-controller="SessionRooms"
   asp-action="New"
   class="btn btn-primary mb-3">
    <i class="fa-solid fa-plus"></i> Add SessionRoom
</a>

@foreach(var sr in ViewBag.SessionRooms)
{
    <div class="song-card p-3 mb-3 border rounded d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center">
            <img src="~/images/people.png" style="height:24px;" class="me-2" />
            <h4 class="mb-0">
                @sr.Name - @sr.HostUser.Email
            </h4>
        </div>

        <a asp-action="Show" asp-route-id="@sr.Id" class="btn btn-primary">
            Show
        </a>

    </div>

}
