@model Orpheo.Models.SessionRoom
@using System.Security.Claims

<h2>Edit Session Room</h2>

<h4>Participants</h4>
<ul class="list-group mb-3">
    @foreach (var sru in Model.SessionRoomUsers)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            @sru.User.Email

            <form asp-action="RemoveParticipant"
                  asp-route-roomId="@Model.Id"
                  asp-route-userId="@sru.UserId"
                  method="post">
                <button class="btn btn-danger btn-sm">
                    Remove
                </button>
            </form>
        </li>
    }
</ul>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <!-- nume -->
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" know />
    </div>

    <!-- playlist -->
    <div class="mb-3">
        <label class="form-label">Playlist</label>
        <select asp-for="PlaylistId"
                asp-items="ViewBag.Playlists"
                class="form-select">
        </select>
    </div>

    <button class="btn btn-primary">Save changes</button>

</form>
