@model Orpheo.Models.Song
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Adaugă cântec";
    var tags = ViewBag.Tags as IEnumerable<SelectListItem>;
}

<h2>Adaugă cântec</h2>

<form asp-action="New" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Artist" class="form-label"></label>
        <input asp-for="Artist" class="form-control" />
        <span asp-validation-for="Artist" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Url" class="form-label"></label>
        <input asp-for="Url" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Data publicarii</label>
        <input asp-for="DataPublicarii" type="Date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Taguri</label>
        <select name="SelectedTags" multiple class="form-control">
            @if (tags != null)
            {
                foreach (var tag in tags)
                {
                    <option value="@tag.Value">@tag.Text</option>
                }
            }
        </select>
        <small class="form-text text-muted">Ține Ctrl (sau Cmd) pentru selecție multiplă.</small>
    </div>

    <button type="submit" class="btn btn-primary">Salvează</button>
    <a asp-action="Index" class="btn btn-secondary">Renunță</a>
</form>
