@model Orpheo.Models.Song
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Adaugă cântec";
    var tags = ViewBag.Tags as IEnumerable<SelectListItem>;
}

<h2>Add song</h2>

<form asp-action="New" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Artist" class="form-label"></label>
        <input asp-for="Artist" class="form-control" />
        <span asp-validation-for="Artist" class="text-danger"></span>
    </div> 

    <div class="form-group">
        <label>Upload MP3</label>
        <input type="file" name="AudioFile" accept=".mp3" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label>Date</label>
        <input asp-for="DataPublicarii" type="Date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tags</label>
        <select name="SelectedTags" multiple class="form-control">
            @if (tags != null)
            {
                foreach (var tag in tags)
                {
                    <option value="@tag.Value">@tag.Text</option>
                }
            }
        </select>
        <small class="form-text text-muted">Ctrl/Cmd - for multiple selection</small>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
