@model Orpheo.Models.Song
@using Orpheo.Models




@{
    ViewData["Title"] = "Song Details";
}

<h2>@Model.Title</h2>
<p class="user-inline">
    <img src="@(Model.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
         class="user-avatar"
         alt="user avatar" />

    <strong>@Model.User?.Name</strong>
<p><strong>Date:</strong> @Model.DataPublicarii </p>

<div class="mb-3">
    <button class="btn btn-primary" onclick="togglePlay(@Model.Id)">
        <i id="icon-@Model.Id" class="fa-solid fa-play"></i>
        Listen
    </button>

    <audio id="audio-@Model.Id" src="@Model.Url"></audio>

    <input type="range"
           id="progress-@Model.Id"
           class="form-range mt-2"
           min="0"
           max="100"
           value="0" />

</div>


@if (Model.SongTags != null && Model.SongTags.Any())
{
    <p>
        <strong>Tags:</strong>
        @foreach (var st in Model.SongTags)
        {
            <span class="badge bg-secondary">@st.Tag?.Name</span>
        }
    </p>
}




@* Butoane edit/delete pentru cântec *@
@if (ViewBag.AfisareButoane == true && Model.UserId == ViewBag.UserCurent)
{
    <p>
        <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"> <i class="bi bi-pencil-square"></i></a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> <i class="bi bi-trash-fill"></i></a>
        </div>
    </p>
}
else if (ViewBag.IsAdmin == true)
{
    <p>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> <i class="bi bi-trash-fill"></i></a>
    </p>
}

<hr />

<h4>Comments</h4>

@* LISTĂ COMENTARII *@
@if (Model.Comms != null && Model.Comms.Any())
{
    @foreach (var c in Model.Comms.OrderByDescending(c => c.CreatedAt))
    {
        <div class="card p-3 mb-3">

            <p>@c.Text</p>
            <small>@c.CreatedAt.ToString("g")</small>
            <br />
            <div class="user-inline mt-1">
                <img src="@(c.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                     class="user-avatar"
                     alt="user avatar" />

                <strong>@c.User?.Name</strong>
            </div>


            @* Butoane doar dacă userul e autor sau admin *@
            @if (c.UserId == ViewBag.UserCurent)
            {
                <div class="d-flex mt-2">

                    <a class="btn btn-outline-primary me-2"
                       asp-controller="Comms"
                       asp-action="Edit"
                       asp-route-id="@c.Id">
                        <i class="bi bi-pencil-square"></i>
                    </a>

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> 
                        </button>
                    </form>

                </div>
            }
            else if (ViewBag.IsAdmin == true)
            {
                <div class="d-flex mt-2">

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> 
                        </button>
                    </form>

                </div>
            }

        </div>
    }
}
else
{
    <p>There are no comments.</p>
}

@* FORM ADAUGARE COMENTARIU *@
@if (User.Identity.IsAuthenticated)
{
    <h4>Add comment</h4>

    <form asp-action="Show" asp-controller="Songs" method="post">
        <input type="hidden" name="SongId" value="@Model.Id" />

        <div class="form-group">
            <label for="Text">Comment</label>
            <textarea class="form-control" name="Text"></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Post</button>
    </form>
}
else
{
        <p><em>You must be logged in to post comments.</em></p>
}

<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll("audio[id^='audio-']").forEach(audio => {
            const id = audio.id.replace("audio-", "");
            const progress = document.getElementById("progress-" + id);

            // când se încarcă durata
            audio.addEventListener("loadedmetadata", () => {
                progress.value = 0;
            });

            // când melodia rulează
            audio.addEventListener("timeupdate", () => {
                if (!audio.duration) return;
                progress.value = (audio.currentTime / audio.duration) * 100;
            });

            // seek
            progress.addEventListener("input", () => {
                if (!audio.duration) return;
                audio.currentTime = (progress.value / 100) * audio.duration;
            });
        });
    });

    function togglePlay(id) {
        const audio = document.getElementById("audio-" + id);
        const icon = document.getElementById("icon-" + id);

        document.querySelectorAll("audio[id^='audio-']").forEach(a => {
            if (a !== audio) {
                a.pause();
                a.currentTime = 0;

                const otherId = a.id.replace("audio-", "");
                document.getElementById("progress-" + otherId).value = 0;
                document.getElementById("icon-" + otherId)
                    .classList.replace("fa-pause", "fa-play");
            }
        });

        if (audio.paused) {
            audio.play();
            icon.classList.replace("fa-play", "fa-pause");
        } else {
            audio.pause();
            icon.classList.replace("fa-pause", "fa-play");
        }
    }
</script>
