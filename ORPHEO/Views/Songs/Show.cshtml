@model Orpheo.Models.Song
@using Orpheo.Models




@{
    ViewData["Title"] = "Song Details";
}

<h2>@Model.Title</h2>
<p><strong>Artist:</strong> @Model.Artist</p>
<p><strong>Date:</strong> @Model.DataPublicarii </p>
<p><strong>By:</strong> @Model.User?.Name</p>

@if (Model.SongTags != null && Model.SongTags.Any())
{
    <p>
        <strong>Tags:</strong>
        @foreach (var st in Model.SongTags)
        {
            <span class="badge bg-secondary">@st.Tag?.Name</span>
        }
    </p>
}




@* Butoane edit/delete pentru cântec *@
@if (ViewBag.AfisareButoane == true && Model.UserId == ViewBag.UserCurent)
{
    <p>
        <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"> <i class="bi bi-pencil-square"></i></a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> <i class="bi bi-trash-fill"></i></a>
        </div>
    </p>
}
else if (ViewBag.IsAdmin == true)
{
    <p>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> <i class="bi bi-trash-fill"></i></a>
    </p>
}

<hr />

<h4>Comments</h4>

@* lista comms *@
@if (Model.Comms != null && Model.Comms.Any())
{
    @foreach (var c in Model.Comms.OrderByDescending(c => c.CreatedAt))
    {
        <div class="card p-3 mb-3">

            <p>@c.Text</p>
            <small>@c.CreatedAt.ToString("g")</small>
            <br />
            <strong><i class="bi bi-person"></i> @c.User?.Name</strong>

            @* butoane doar daca userul e artist sau admin *@
            @if (c.UserId == ViewBag.UserCurent)
            {
                <div class="d-flex mt-2">

                    <a class="btn btn-outline-primary me-2"
                       asp-controller="Comms"
                       asp-action="Edit"
                       asp-route-id="@c.Id">
                        <i class="bi bi-pencil-square"></i>
                    </a>

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> 
                        </button>
                    </form>

                </div>
            }
            else if (ViewBag.IsAdmin == true)
            {
                <div class="d-flex mt-2">

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> 
                        </button>
                    </form>

                </div>
            }

        </div>
    }
}
else
{
    <p>There are no comments.</p>
}

@* form adaugare comentariu *@
@if (User.Identity.IsAuthenticated)
{
    <h4>Add comment</h4>

    <form asp-action="Show" asp-controller="Songs" method="post">
        <input type="hidden" name="SongId" value="@Model.Id" />

        <div class="form-group">
            <label for="Text">Comment</label>
            <textarea class="form-control" name="Text"></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Post</button>
    </form>
}
else
{
        <p><em>You must be logged in to post comments.</em></p>
}

<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</p>
