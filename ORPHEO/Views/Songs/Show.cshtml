@model Orpheo.Models.Song
@using Orpheo.Models

@{
    ViewData["Title"] = Model.Title;
}
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}


<!-- TITLE + ARTIST -->
<h2 class="orpheo-song-title mb-1">@Model.Title</h2>

<div class="d-flex align-items-center mb-4">
    <img src="@(Model.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
         class="user-avatar me-2" />

    <span class="orpheo-artist-name">
        @Model.User?.Name
    </span>

    <span class="ms-3 text-muted small">
        <i class="bi bi-calendar3"></i>
        @Model.DataPublicarii.ToString("dd MMM yyyy")
    </span>
</div>

<!-- PLAYER -->
<div class="mb-4">
    <button class="btn btn-orpheo-play"
            onclick="togglePlay(@Model.Id)">
        <i id="icon-@Model.Id" class="fa-solid fa-play"></i>
        Listen
    </button>

    <audio id="audio-@Model.Id" src="@Model.Url"></audio>

    <input type="range"
           id="progress-@Model.Id"
           class="form-range mt-3"
           min="0" max="100" value="0" />
</div>

<!-- TAGS -->
@if (Model.SongTags != null && Model.SongTags.Any())
{
    <div class="mb-4">
        @foreach (var st in Model.SongTags)
        {
            <span class="orpheo-tag me-1">@st.Tag?.Name</span>
        }
    </div>
}

<!-- EDIT / DELETE -->
@if (ViewBag.AfisareButoane == true && Model.UserId == ViewBag.UserCurent)
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-orpheo">
            <i class="bi bi-pencil-square"></i> Edit>
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn-cancel">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    </div>
}
else if (ViewBag.IsAdmin == true)
{
    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-outline-danger btn-sm">
            <i class="bi bi-trash-fill"></i>
        </a>
    </div>
}

<hr />

<!-- AI ANALYSIS -->
@if ((User.IsInRole("Admin") || (User.IsInRole("Artist") && Model.UserId == ViewBag.UserCurent))
     && !string.IsNullOrEmpty(Model.Lyrics))
{
    <form asp-action="AnalyzeWithAi"
          asp-route-id="@Model.Id"
          method="post"
          class="mb-4">

        <button class="btn btn-outline-info">
            <i class="bi bi-robot"></i>
            Analyze with AI
        </button>
    </form>
}

<!-- LYRICS -->
@if (!string.IsNullOrWhiteSpace(Model.Lyrics))
{
    <div class="mb-5">
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                type="button"
                onclick="toggleLyrics()">
            <span id="lyrics-arrow">▼</span>
            <strong>Lyrics</strong>
        </button>

        <div id="lyrics-content" class="orpheo-lyrics mt-3" style="display:none;">
            @Model.Lyrics
        </div>
    </div>
}

<!-- COMMENTS -->
<h4 class="mb-3">Comments</h4>

@if (Model.Comms != null && Model.Comms.Any())
{
    @foreach (var c in Model.Comms.OrderByDescending(c => c.CreatedAt))
    {
        <div class="orpheo-card mb-3 p-3">
            <p>@c.Text</p>

            <small class="text-muted">
                @c.CreatedAt.ToString("g")
            </small>

            <div class="d-flex align-items-center mt-2">
                <img src="@(c.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                     class="user-avatar me-2" />
                <strong>@c.User?.Name</strong>
            </div>

            @if (c.UserId == ViewBag.UserCurent || ViewBag.IsAdmin == true)
            {
                <div class="d-flex gap-2 mt-2">
                    <a asp-controller="Comms"
                       asp-action="Edit"
                       asp-route-id="@c.Id"
                       class="btn btn-outline-light btn-sm">
                        <i class="bi bi-pencil-square"></i>
                    </a>

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
}
else
{
    <p class="text-muted">There are no comments.</p>
}

<!-- ADD COMMENT -->
@if (User.Identity.IsAuthenticated)
{
    <h5 class="mt-4">Add comment</h5>

    <form asp-action="Show" asp-controller="Songs" method="post">
        <input type="hidden" name="SongId" value="@Model.Id" />

        <textarea class="form-control orpheo-textarea mb-2"
              name="Text"
              placeholder="Write your comment..."></textarea>


        <button class="btn btn-orpheo">
            Post
        </button>
    </form>
}
else
{
    <p class="text-muted"><em>You must be logged in to post comments.</em></p>
}

<a asp-action="Index" class="btn btn-outline-light mt-4">
    ← Back
</a>

<!-- JS -->
<script>
    function togglePlay(id) {
        const audio = document.getElementById("audio-" + id);
        const icon = document.getElementById("icon-" + id);

        if (audio.paused) {
            audio.play();
            icon.classList.replace("fa-play", "fa-pause");
        } else {
            audio.pause();
            icon.classList.replace("fa-pause", "fa-play");
        }
    }

    function toggleLyrics() {
        const content = document.getElementById("lyrics-content");
        const arrow = document.getElementById("lyrics-arrow");

        if (content.style.display === "none") {
            content.style.display = "block";
            arrow.textContent = "▲";
        } else {
            content.style.display = "none";
            arrow.textContent = "▼";
        }
    }
</script>
