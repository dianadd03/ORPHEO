@model Orpheo.Models.Song
@using Orpheo.Models

@{
    ViewData["Title"] = "Detalii cântec";
}

<h2>@Model.Title</h2>
<p><strong>Artist:</strong> @Model.Artist</p>
<p><strong>Url:</strong> <a href="@Model.Url" target="_blank">@Model.Url</a></p>
<p><strong>Data Publicarii:</strong> @Model.DataPublicarii </p>
<p><strong>Adăugat de:</strong> @Model.User?.UserName</p>

@if (Model.SongTags != null && Model.SongTags.Any())
{
    <p>
        <strong>Taguri:</strong>
        @foreach (var st in Model.SongTags)
        {
            <span class="badge bg-secondary">@st.Tag?.Name</span>
        }
    </p>
}

@* Butoane edit/delete pentru cântec *@
@if (ViewBag.AfisareButoane == true && Model.UserId == ViewBag.UserCurent)
{
    <p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editează</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Șterge</a>
    </p>
}
else if (ViewBag.IsAdmin == true)
{
    <p>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Șterge</a>
    </p>
}

<hr />

<h4>Comentarii</h4>

@* LISTĂ COMENTARII *@
@if (Model.Comms != null && Model.Comms.Any())
{
    @foreach (var c in Model.Comms.OrderByDescending(c => c.CreatedAt))
    {
        <div class="card p-3 mb-3">

            <p>@c.Text</p>
            <small>@c.CreatedAt.ToString("g")</small>
            <br />
            <strong><i class="bi bi-person"></i> @c.User?.UserName</strong>

            @* Butoane doar dacă userul e autor sau admin *@
            @if (c.UserId == ViewBag.UserCurent)
            {
                <div class="d-flex mt-2">

                    <a class="btn btn-outline-primary me-2"
                       asp-controller="Comms"
                       asp-action="Edit"
                       asp-route-id="@c.Id">
                        <i class="bi bi-pencil-square"></i> Editează
                    </a>

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> Șterge
                        </button>
                    </form>

                </div>
            }
            else if (ViewBag.IsAdmin == true)
            {
                <div class="d-flex mt-2">

                    <form method="post"
                          asp-controller="Comms"
                          asp-action="Delete"
                          asp-route-id="@c.Id">
                        <button class="btn btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i> Șterge
                        </button>
                    </form>

                </div>
            }

        </div>
    }
}
else
{
    <p>Nu există comentarii.</p>
}

@* FORM ADAUGARE COMENTARIU *@
@if (User.Identity.IsAuthenticated)
{
    <h4>Adaugă comentariu</h4>

    <form asp-action="Show" asp-controller="Songs" method="post">
        <input type="hidden" name="SongId" value="@Model.Id" />

        <div class="form-group">
            <label for="Text">Comentariu</label>
            <textarea class="form-control" name="Text"></textarea>
        </div>

        <button type="submit" class="btn btn-primary mt-2">Trimite</button>
    </form>
}
else
{
    <p><em>Trebuie să fii logat pentru a posta comentarii.</em></p>
}

<p class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Înapoi la listă</a>
</p>
