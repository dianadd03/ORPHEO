@model Orpheo.Models.Song
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit song";
    var tags = ViewBag.Tags as IEnumerable<SelectListItem>;
    var selectedTags = ViewBag.SelectedTags as List<int>;
}

<h2>Edit song</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- TITLE -->
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <!-- ARTIST (READ-ONLY) -->
    <div class="mb-3">
        <label class="form-label">Artist</label>
        <input class="form-control" value="@Model.User?.Name" disabled />
    </div>

    <!-- AUDIO -->
    <div class="form-group mt-3">
        <label>Replace MP3 file (optional)</label>
        <input type="file" name="NewAudioFile" accept=".mp3" class="form-control" />
    </div>

    @if (!string.IsNullOrEmpty(Model.Url))
    {
        <p class="mt-2"><strong>Current file:</strong></p>
        <audio controls style="width:100%;">
            <source src="@Model.Url" type="audio/mpeg">
        </audio>
    }

    <!-- TAGS -->
    <div class="mb-3">
        <label class="form-label">Tags</label>
        <select name="SelectedTags" multiple class="form-select">
            @if (tags != null)
            {
                foreach (var tag in tags)
                {
                    var isSelected = selectedTags != null &&
                    selectedTags.Contains(int.Parse(tag.Value));

                    <option value="@tag.Value" selected="@(isSelected ? "selected" : null)">
                        @tag.Text
                    </option>
                }
            }
        </select>
    </div>

    <!-- BUTTONS -->
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
