@model Orpheo.Models.Song

@{
    ViewData["Title"] = "Șterge cântec";
}

<h2>Delete song</h2>

<h4>Are you sure you want to delete this song?</h4>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Artist</dt>
    <dd class="col-sm-10 d-flex align-items-center gap-2">
        <img src="@(Model.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
             class="user-avatar"
             alt="artist avatar" />
        <strong>@Model.User?.Name</strong>
    </dd>

    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@Model.Url</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
