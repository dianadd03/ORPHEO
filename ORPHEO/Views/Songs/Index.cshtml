@{
    ViewData["Title"] = "Songs";
}

@using Orpheo.Data
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext _context
@inject UserManager<ApplicationUser> _userManager

<form method="post">
    @Html.AntiForgeryToken()
</form>


@if (TempData["message"] != null)
{
    <div class="alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}


<h2 class="mb-4 text-center">All Songs</h2>

<!-- SEARCH -->
<form method="get" asp-action="Index" class="input-group mb-4">
    <input type="text"
           name="search"
           class="form-control orpheo-input"
           placeholder="Search songs, artists, tags..."
           value="@ViewBag.Search" />

    <button class="btn btn-orpheo">
        Search
    </button>
</form>

@{
    string sort = ViewBag.Sort as string ?? "date";
}

<!-- SORT -->
<form method="get" asp-action="Index" class="mb-4 text-center">
    <input type="hidden" name="search" value="@ViewBag.Search" />

    <select name="sort"
            class="form-select orpheo-select d-inline-block w-auto"
            onchange="this.form.submit()">

        <option value="date" selected="@(sort == "date")">
            Sort by date (newest)
        </option>
        <option value="likes" selected="@(sort == "likes")">
            Sort by likes
        </option>
    </select>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}

@if (ViewBag.AfisareButoane == true)
{
    <div class="text-center mb-4">
        <a class="btn btn-orpheo" href="/Songs/New">
            <i class="fa-solid fa-plus"></i> Add Song
        </a>
    </div>
}

<!-- SONG LIST -->
<div class="row g-4">

    @foreach (Orpheo.Models.Song song in ViewBag.Songs)
    {
        <div class="col-12">
            <div class="orpheo-card h-100 p-3">

                <h5 class="fw-semibold mb-1">@song.Title</h5>

                <div class="d-flex align-items-center mb-3">
                    <img src="@(song.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                         class="user-avatar me-2" />
                    <span class="text-muted small">@song.User?.Name</span>
                </div>

                <!-- PLAYER -->
                <div class="mb-3">
                    <button class="btn btn-orpheo-play btn-sm"
                            onclick="togglePlay(@song.Id)">
                        <i id="icon-@song.Id" class="fa-solid fa-play"></i>
                        Listen
                    </button>

                    <audio id="audio-@song.Id" src="@song.Url"></audio>

                    <input type="range"
                           id="progress-@song.Id"
                           class="form-range mt-2"
                           min="0" max="100" value="0" />
                </div>

                <hr />

                <div class="d-flex flex-wrap gap-2 align-items-center">

                    <!-- LIKE / DISLIKE -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        string userId = _userManager.GetUserId(User);
                        var vote = _context.SongVotes
                        .FirstOrDefault(v => v.SongId == song.Id && v.UserId == userId);

                        bool? isLike = vote?.IsLike;

                        <button type="button"
                                class="btn @(isLike == true ? "btn-pink" : "btn-outline-pink") like-btn"
                                data-id="@song.Id">
                            <i class="bi bi-heart-fill"></i>
                        </button>

                        <button type="button"
                                class="btn @(isLike == false ? "btn-pink" : "btn-outline-pink") dislike-btn"
                                data-id="@song.Id">
                            <i class="bi bi-hand-thumbs-down-fill"></i>
                        </button>
                    }

                    <!-- ADD TO PLAYLIST -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form method="post"
                              action="/Playlists/AddSong"
                              class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="songId" value="@song.Id" />

                            <select name="playlistId"
                                    class="form-select form-select-sm orpheo-select"
                                    style="width:140px;">
                                <option disabled selected>Playlist…</option>
                                @foreach (var p in ViewBag.Playlists)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>

                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </form>
                    }

                    <!-- DETAILS -->
                    <a href="/Songs/Show/@song.Id"
                       class="btn btn-outline-light btn-sm ms-auto">
                        Details
                    </a>
                </div>

            </div>
        </div>
    }

</div>

<!-- PAGINATION -->
<div class="mt-5 d-flex justify-content-center">
    <nav>
        <ul class="pagination">

            <li class="page-item">
                <a class="page-link"
                   href="@($"{ViewBag.PaginationBaseUrl}1")">&laquo;</a>
            </li>

            @for (int i = 1; i <= ViewBag.lastPage; i++)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@($"{ViewBag.PaginationBaseUrl}{i}")">
                        @i
                    </a>
                </li>
            }

            <li class="page-item">
                <a class="page-link"
                   href="@($"{ViewBag.PaginationBaseUrl}{ViewBag.lastPage}")">&raquo;</a>
            </li>

        </ul>
    </nav>
</div>


<!-- script audio -->
<script>
    document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll("audio[id^='audio-']").forEach(audio => {
            const id = audio.id.replace("audio-", "");
            const progress = document.getElementById("progress-" + id);

            // când se încarcă durata
            audio.addEventListener("loadedmetadata", () => {
                progress.value = 0;
            });

            // când melodia rulează
            audio.addEventListener("timeupdate", () => {
                if (!audio.duration) return;
                progress.value = (audio.currentTime / audio.duration) * 100;
            });

            // seek
            progress.addEventListener("input", () => {
                if (!audio.duration) return;
                audio.currentTime = (progress.value / 100) * audio.duration;
            });
        });
    });

    function togglePlay(id) {
        const audio = document.getElementById("audio-" + id);
        const icon = document.getElementById("icon-" + id);

        document.querySelectorAll("audio[id^='audio-']").forEach(a => {
            if (a !== audio) {
                a.pause();
                a.currentTime = 0;

                const otherId = a.id.replace("audio-", "");
                document.getElementById("progress-" + otherId).value = 0;
                document.getElementById("icon-" + otherId)
                    .classList.replace("fa-pause", "fa-play");
            }
        });

        if (audio.paused) {
            audio.play();
            icon.classList.replace("fa-play", "fa-pause");
        } else {
            audio.pause();
            icon.classList.replace("fa-pause", "fa-play");
        }
    }
</script>



<style>
    .song-card {
        border-radius: 12px;
        transition: 0.2s;
    }

        .song-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.1);
        }
</style>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll(".like-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                vote("/Songs/Like", btn);
            });
        });

        document.querySelectorAll(".dislike-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                vote("/Songs/Dislike", btn);
            });
        });

        function vote(url, btn) {
            const songId = btn.dataset.id;

            fetch(url + "/" + songId, {
                method: "POST",
                headers: {
                    "RequestVerificationToken":
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {

                console.log("DATA DIN SERVER:", data); 

                const container = btn.parentElement;

                const likeBtn = container.querySelector(".like-btn");
                const dislikeBtn = container.querySelector(".dislike-btn");

                likeBtn.className = "btn btn-outline-pink like-btn";
                dislikeBtn.className = "btn btn-outline-pink dislike-btn";

                if (data.liked === true) {
                    likeBtn.className = "btn btn-pink like-btn";
                }

                if (data.disliked === true) {
                    dislikeBtn.className = "btn btn-pink dislike-btn";
                }
            })
            .catch(err => {
                console.error("EROARE FETCH:", err);
            });
        }
    });
</script>


