@{
    ViewData["Title"] = "Songs";
}

<h2 class="mb-4">All Songs</h2>

<form method="get" asp-action="Index" class="d-flex mb-4">
    <input type="text"
           name="search"
           class="form-control"
           placeholder="Search song..."
           value="@ViewBag.Search" />

    <button class="btn btn-primary ms-2">Search</button>
</form>


@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}
@if (ViewBag.AfisareButoane == true)
{
    <a class="btn btn-primary mb-4" href="/Songs/New">
        <i class="fa-solid fa-plus"></i> Add Song
    </a>
}

<!-- Lista de melodii -->
@foreach (var song in ViewBag.Songs)
{
    <div class="song-card shadow-sm p-3 mb-4 d-flex align-items-center rounded"
         style="background:#f9f9f9;">

        <!-- Icon Play -->
        <button class="btn btn-light play-btn me-3"
                onclick="togglePlay('@song.Id')"
                style="width:50px;height:50px;border-radius:50%;
                           box-shadow:0 2px 6px rgba(0,0,0,0.15);">
            <i id="icon-@song.Id" class="fa-solid fa-play"></i>
        </button>

        <!-- Song Info -->
        <div style="flex-grow:1;">
            <h5 class="mb-1">@song.Title</h5>
            <p class="text-muted mb-0">@song.Artist</p>
        </div>

        <!-- Audio Player ascuns -->
        <audio id="audio-@song.Id" style="display:none;">
            <source src="@song.Url" type="audio/mpeg" />
        </audio>

        <!-- Buton Details -->
        <a href="/Songs/Show/@song.Id"
           class="btn btn-outline-secondary ms-3">
            Details
        </a>

        <!-- Add to playlist (only for logged users) -->
        @if (User.Identity.IsAuthenticated)
        {
            <button class="btn btn-success ms-3"
                    data-bs-toggle="modal"
                    data-bs-target="#addToPlaylistModal"
                    data-song-id="@song.Id">
                Add to playlist
            </button>
        }

    </div>
}

<div class="modal fade" id="addToPlaylistModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Playlists" asp-action="AddSongToPlaylist" method="post">
                <input type="hidden" id="modalSongId" name="SongId" />

                <div class="modal-header">
                    <h5 class="modal-title">Add song to playlist</h5>
                </div>

                <div class="modal-body">

                    @if (((List<Playlist>)ViewBag.Playlists)?.Any() == true)
                    {

                        <label>Playlist name:</label>
                        <input class="form-control" name="NewPlaylistName" placeholder="Enter playlist name..." required />

                    }
                    else
                    {
                        <p>You don't have any playlists yet.</p>
                        <label>Create new playlist:</label>
                        <input class="form-control" name="NewPlaylistName" />
                    }

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- Script Play/Pause -->
<script>
    function togglePlay(id) {
        var audio = document.getElementById("audio-" + id);
        var icon = document.getElementById("icon-" + id);

        if (audio.paused) {

            // Oprește orice altă melodie
            document.querySelectorAll("audio").forEach(a => {
                if (a !== audio) {
                    a.pause();
                    a.currentTime = 0;

                    let otherIcon = document.getElementById("icon-" + a.id.replace("audio-", ""));
                    if (otherIcon) {
                        otherIcon.classList.remove("fa-pause");
                        otherIcon.classList.add("fa-play");
                    }
                }
            });

            audio.play();
            icon.classList.remove("fa-play");
            icon.classList.add("fa-pause");
        }
        else {
            audio.pause();
            icon.classList.remove("fa-pause");
            icon.classList.add("fa-play");
        }
    }
</script>


<script>
    const modal = document.getElementById("addToPlaylistModal");

    modal.addEventListener("show.bs.modal", function (event) {

        let btn = event.relatedTarget;
        let songId = btn.getAttribute("data-song-id");
        document.getElementById("modalSongId").value = songId;

        // 🔥 Resetăm dropdown-ul la opțiunea goală
        let select = modal.querySelector("select[name='PlaylistId']");
        if (select) {
            select.selectedIndex = 0; // selectează "Choose playlist..."
        }
    });
</script>



<style>
    .song-card:hover {
        background: #f1f1f1;
        transition: 0.2s;
    }

    .play-btn i {
        font-size: 20px;
    }
</style>
