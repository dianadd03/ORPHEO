@{
    ViewData["Title"] = "Songs";
}

@using Orpheo.Data
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext _context
@inject UserManager<ApplicationUser> _userManager

<h2 class="mb-4">All Songs</h2>

<!-- search -->
<form method="get" asp-action="Index" class="input-group mb-3">
    <input type="text"
           name="search"
           class="form-control"
           placeholder="Search songs, artists, tags..."
           value="@ViewBag.Search" />

    <button class="btn btn-outline-success" type="submit">
        Search
    </button>
</form>

@{
    string sort = ViewBag.Sort as string ?? "date";
}

<!-- sort -->
<form method="get" asp-action="Index" class="mb-4">
    <input type="hidden" name="search" value="@ViewBag.Search" />

    <select name="sort"
            class="form-select w-auto d-inline-block"
            onchange="this.form.submit()">

        @if (sort == "date")
        {
            <option value="date" selected>Sort by date (newest)</option>
            <option value="likes">Sort by likes</option>
        }
        else
        {
            <option value="date">Sort by date (newest)</option>
            <option value="likes" selected>Sort by likes</option>
        }

    </select>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}

@if (ViewBag.AfisareButoane == true)
{
    <a class="btn btn-primary mb-4" href="/Songs/New">
        <i class="fa-solid fa-plus"></i> Add Song
    </a>
}

<!-- lista cantece -->
<div class="row row-cols-1 g-4">

    @foreach (var song in ViewBag.Songs)
    {
        <div class="col">
            <div class="card shadow-sm border-0 song-card">
                <div class="card-body">

                    <h5 class="fw-bold">@song.Title</h5>
                    <div class="user-inline mb-2">
                        <img src="@(song.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                             class="user-avatar"
                             alt="user avatar" />

                        <small>
                            @song.User?.Name
                        </small>
                    </div>

                    <!-- PLAYER -->
                    <div class="mb-3">
                        <button class="btn btn-primary" onclick="togglePlay(@song.Id)">
                            <i id="icon-@song.Id" class="fa-solid fa-play"></i>
                            Listen
                        </button>

                        <audio id="audio-@song.Id" src="@song.Url"></audio>

                        <input type="range"
                               id="progress-@song.Id"
                               class="form-range mt-2"
                               min="0"
                               max="100"
                               value="0" />

                    </div>

                    <hr />

                    <div class="d-flex flex-wrap gap-3 align-items-center">

                        <!-- LIKE / DISLIKE  -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            string userId = _userManager.GetUserId(User);
                            int songId = song.Id;

                            var vote = _context.SongVotes
                            .FirstOrDefault(v => v.SongId == songId && v.UserId == userId);

                            bool? isLike = vote?.IsLike;

                            <a asp-controller="Songs"
                               asp-action="Like"
                               asp-route-id="@song.Id"
                               class="btn @(isLike == true ? "btn-pink" : "btn-outline-pink")">
                                <i class="bi bi-hand-thumbs-up-fill"></i>
                            </a>

                            <a asp-controller="Songs"
                               asp-action="Dislike"
                               asp-route-id="@song.Id"
                               class="btn @(isLike == false ? "btn-pink" : "btn-outline-pink")">
                                <i class="bi bi-hand-thumbs-down-fill"></i>
                            </a>
                        }

                        <!-- add la pls -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form method="post" action="/Playlists/AddSong" class="d-flex gap-2">
                                <input type="hidden" name="songId" value="@song.Id" />

                                <select name="playlistId"
                                        class="form-select form-select-sm"
                                        style="width:150px;">
                                    <option disabled selected>Playlist...</option>

                                    @foreach (var p in ViewBag.Playlists)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </form>
                        }
                        <!-- detalii -->
                        <a href="/Songs/Show/@song.Id"
                           class="btn btn-outline-secondary btn-sm">
                            Details
                        </a>

                    </div>

                </div>
            </div>
        </div>
    }

</div>

<!-- paginatie -->
<div class="mt-4">
    <nav>
        <ul class="pagination">

            <li class="page-item">
                <a class="page-link" href="@($"{ViewBag.PaginationBaseUrl}1")">&laquo;</a>
            </li>

            @for (int i = 1; i <= ViewBag.lastPage; i++)
            {
                <li class="page-item">
                    <a class="page-link" href="@($"{ViewBag.PaginationBaseUrl}{i}")">
                        @i
                    </a>
                </li>
            }

            <li class="page-item">
                <a class="page-link" href="@($"{ViewBag.PaginationBaseUrl}{ViewBag.lastPage}")">&raquo;</a>
            </li>

        </ul>
    </nav>
</div>

<!-- script audio -->
<script>
    document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll("audio[id^='audio-']").forEach(audio => {
            const id = audio.id.replace("audio-", "");
            const progress = document.getElementById("progress-" + id);

            // când se încarcă durata
            audio.addEventListener("loadedmetadata", () => {
                progress.value = 0;
            });

            // când melodia rulează
            audio.addEventListener("timeupdate", () => {
                if (!audio.duration) return;
                progress.value = (audio.currentTime / audio.duration) * 100;
            });

            // seek
            progress.addEventListener("input", () => {
                if (!audio.duration) return;
                audio.currentTime = (progress.value / 100) * audio.duration;
            });
        });
    });

    function togglePlay(id) {
        const audio = document.getElementById("audio-" + id);
        const icon = document.getElementById("icon-" + id);

        document.querySelectorAll("audio[id^='audio-']").forEach(a => {
            if (a !== audio) {
                a.pause();
                a.currentTime = 0;

                const otherId = a.id.replace("audio-", "");
                document.getElementById("progress-" + otherId).value = 0;
                document.getElementById("icon-" + otherId)
                    .classList.replace("fa-pause", "fa-play");
            }
        });

        if (audio.paused) {
            audio.play();
            icon.classList.replace("fa-play", "fa-pause");
        } else {
            audio.pause();
            icon.classList.replace("fa-pause", "fa-play");
        }
    }
</script>



<style>
    .song-card {
        border-radius: 12px;
        transition: 0.2s;
    }

        .song-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.1);
        }
</style>
