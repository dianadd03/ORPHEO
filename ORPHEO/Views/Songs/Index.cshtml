@{
    ViewData["Title"] = "Songs";
}
@using Orpheo.Data
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext _context
@inject UserManager<ApplicationUser> _userManager

<h2 class="mb-4">All Songs</h2>

<form method="get" asp-action="Index" class="d-flex mb-4">
    <input type="text"
           name="search"
           class="form-control"
           placeholder="Search song..."
           value="@ViewBag.Search" />

    <button class="btn btn-primary ms-2">Search</button>
</form>


@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType mt-2">
        @ViewBag.Message
    </div>
}
@if (ViewBag.AfisareButoane == true)
{
    <a class="btn btn-primary mb-4" href="/Songs/New">
        <i class="fa-solid fa-plus"></i> Add Song
    </a>
}

@foreach (var song in ViewBag.Songs)
{
    <div class="song-card p-3 mb-3 border rounded">

        <h4>@song.Title – @song.Artist</h4>

        <div class="d-flex align-items-center gap-2 mt-2">

            <button class="btn btn-primary" onclick="togglePlay(@song.Id)">
                <i id="icon-@song.Id" class="fa-solid fa-play"></i> Ascultă
            </button>

            <audio id="audio-@song.Id" src="@song.Url"></audio>

            
            @* Formular pentru adăugare în playlist *@
            @if (User.Identity.IsAuthenticated)
            {
                <form method="post" action="/Playlists/AddSong" class="d-flex gap-2 ms-3">
                    <input type="hidden" name="songId" value="@song.Id" />

                    <select name="playlistId" class="form-select" style="width:180px;">
                        <option disabled selected>Select playlist...</option>
                        @foreach (var p in ViewBag.Playlists)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>

                    <button type="submit" class="btn btn-success">
                        ➕ Adaugă
                    </button>
                </form>
            }

            @* ❤️ / 👎 Sistem votare *@
            @{
                var userId = _userManager.GetUserId(User);
                int songId = song.Id;

                var vote = _context.SongVotes
                .FirstOrDefault(v => v.SongId == songId && v.UserId == userId);

                bool? isLike = vote?.IsLike;   // true = like, false = dislike, null = nevotat
            }

            <a asp-action="Like"
               asp-route-id="@song.Id"
               class="btn @(isLike == true ? "btn-pink" : "btn-outline-pink")">
                ❤️
            </a>

            <a asp-action="Dislike"
               asp-route-id="@song.Id"
               class="btn @(isLike == false ? "btn-pink" : "btn-outline-pink")">
                👎
            </a>


            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Playlists/New?songId=@song.Id" class="btn btn-warning">
                    ➕ Playlist nou
                </a>
            }

        </div>

    </div>
}



<div class="modal fade" id="addToPlaylistModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Playlists" asp-action="AddSongToPlaylist" method="post">
                <input type="hidden" id="modalSongId" name="SongId" />

                <div class="modal-header">
                    <h5 class="modal-title">Add song to playlist</h5>
                </div>

                <div class="modal-body">

                    @if (((List<Playlist>)ViewBag.Playlists)?.Any() == true)
                    {

                        <label>Playlist name:</label>
                        <input class="form-control" name="NewPlaylistName" placeholder="Enter playlist name..." required />

                    }
                    else
                    {
                        <p>You don't have any playlists yet.</p>
                        <label>Create new playlist:</label>
                        <input class="form-control" name="NewPlaylistName" />
                    }

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                </div>

            </form>

        </div>
    </div>
</div>


<script>
    function togglePlay(id) {
        var audio = document.getElementById("audio-" + id);
        var icon = document.getElementById("icon-" + id);

        if (audio.paused) {

            // Oprește orice altă melodie
            document.querySelectorAll("audio").forEach(a => {
                if (a !== audio) {
                    a.pause();
                    a.currentTime = 0;

                    let otherIcon = document.getElementById("icon-" + a.id.replace("audio-", ""));
                    if (otherIcon) {
                        otherIcon.classList.remove("fa-pause");
                        otherIcon.classList.add("fa-play");
                    }
                }
            });

            audio.play();
            icon.classList.remove("fa-play");
            icon.classList.add("fa-pause");
        }
        else {
            audio.pause();
            icon.classList.remove("fa-pause");
            icon.classList.add("fa-play");
        }
    }
</script>


<script>
    const modal = document.getElementById("addToPlaylistModal");

    modal.addEventListener("show.bs.modal", function (event) {

        let btn = event.relatedTarget;
        let songId = btn.getAttribute("data-song-id");
        document.getElementById("modalSongId").value = songId;

        let select = modal.querySelector("select[name='PlaylistId']");
        if (select) {
            select.selectedIndex = 0; // selectează "Choose playlist..."
        }
    });
</script>



<style>
    .song-card:hover {
        background: #f1f1f1;
        transition: 0.2s;
    }

    .play-btn i {
        font-size: 20px;
    }
</style>
