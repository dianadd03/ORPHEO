@model IEnumerable<Orpheo.Models.RoleRequest>

<h2 class="section-title">Pending role requests</h2>

@if (!Model.Any())
{
    <div class="empty-state">
        No pending requests.
    </div>
}
else
{
    <div class="request-list">

        @foreach (var req in Model)
        {
            <div class="request-card">

                <div class="request-info">
                    <div class="request-user">
                        @req.User.UserName
                    </div>

                    <div class="request-meta">
                        <span>@req.User.Email</span>
                        <span>Role: <strong>@req.RequestedRole</strong></span>
                        <span>@req.CreatedAt.ToString("dd MMM yyyy • HH:mm")</span>
                    </div>
                </div>

                <div class="request-actions">
                    <a asp-action="Approve"
                       asp-route-id="@req.Id"
                       class="btn-approve">
                        Approve
                    </a>

                    <a asp-action="Reject"
                       asp-route-id="@req.Id"
                       class="btn-reject">
                        Reject
                    </a>
                </div>

            </div>
        }
    </div>
}
