@model Orpheo.Models.Playlist

<h2>Creează playlist</h2>

<form asp-action="New"
      asp-route-SongId="@ViewBag.SongId"
      method="post"
      enctype="multipart/form-data">


    @if (ViewBag.SongId != null)
    {
        <input type="hidden" name="SongId" value="@ViewBag.SongId" />
    }

    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsPublic" />
        <label class="form-check-label" for="IsPublic">Public playlist</label>
    </div>
    <div class="mb-3">
        <label class="form-label">Playlist image</label>
        <input class="form-control" type="file" name="ImageFile" />
    </div>


    <br />

    <button class="btn btn-primary" type="submit">Creează</button>
</form>
