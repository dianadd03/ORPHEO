@model Orpheo.Models.Playlist

@{
    ViewData["Title"] = "Create playlist";
}

<h2 class="orpheo-page-title mb-4">Create playlist</h2>

<!-- ALERT (TempData) -->
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}

<form asp-action="New"
      asp-route-SongId="@ViewBag.SongId"
      method="post"
      enctype="multipart/form-data"
      class="orpheo-form">

    @* Daca venim din AddSong *@
    @if (ViewBag.SongId != null)
    {
        <input type="hidden" name="SongId" value="@ViewBag.SongId" />
    }

    <!-- NAME -->
    <div class="mb-4">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control orpheo-input" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- PUBLIC SWITCH -->
    <div class="form-check form-switch mb-4">
        <input class="form-check-input" type="checkbox" asp-for="IsPublic" />
        <label class="form-check-label">
            Public playlist
        </label>
    </div>

    <!-- IMAGE (optional) -->
    <div class="mb-4">
        <label class="form-label">Playlist image (optional)</label>
        <input class="form-control orpheo-input"
               type="file"
               name="ImageFile"
               accept=".jpg,.jpeg,.png" />
        <small class="text-muted">
            If you don’t choose an image, a default one will be used.
        </small>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex gap-3">
        <button type="submit" class="btn-orpheo">
            Create
        </button>

        <a asp-action="Index" class="btn-cancel">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
