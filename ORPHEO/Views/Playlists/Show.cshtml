@model Orpheo.Models.Playlist



<h2>
    @Model.Name

    @if (Model.IsPublic)
    {
        <i class="bi bi-unlock" title="Public playlist"></i>
    }
    else
    {
        <i class="bi bi-lock" title="Private playlist"></i>
    }
</h2>


<div class="user-inline mb-2">
    <img src="@(Model.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
         class="user-avatar"
         alt="user avatar" />

    <small>
        @Model.User?.Name
    </small>
</div>

@if (ViewBag.AfisareButoane == true)
{
    <p>
        <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil-square"></i>Edit</a>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i>Delete</button>
        </form>
        </div>
    </p>
}

<hr />

<form method="get" class="mb-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="text"
           name="search"
           value="@ViewBag.Search"
           class="form-control"
           placeholder="Search a song..." />
</form>

@if(ViewBag.JustSearched == true)
{
    if(ViewBag.FoundSongTitle != null)
    {
        <div class="alert alert-succes">
            The song <strong>@ViewBag.FoundSongTitle</strong> is here!!!
        </div>

        <div class="p-2 mb-3 bg-success text-white rounded">
            <strong>@ViewBag.FoundSongTitle</strong>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            The song <strong>@ViewBag.Search</strong> isn't here!!!
        </div>
    }
}

<h4>Songs in playlist</h4>


@if (Model.PlaylistSongs.Any())
{
    @foreach (var ps in Model.PlaylistSongs)
    {
        var song = ps.Song;

        <div class="song-card p-3 mb-3 border rounded d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">@song.Title</h5>

                <p class="user-inline">
                    <img src="@(song.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                         class="user-avatar"
                         alt="artist avatar" />

                    <strong>@song.User?.Name</strong>
                </p>
            </div>


            <div class="d-flex align-items-center gap-2">

                <button type="button"
                        class="btn btn-primary"
                        onclick="togglePlaylistPlay(@ps.SongId)">
                    <i id="icon-playlist-@ps.SongId" class="bi bi-play-fill"></i>
                </button>

                 
                <audio id="audio-playlist-@ps.SongId" src="@song.Url"></audio>

                @if (ViewBag.AfisareButoane == true)
                {
                    <form asp-action="RemoveSong" method="post" class="d-inline">
                        <input type="hidden" name="playlistId" value="@Model.Id" />
                        <input type="hidden" name="songId" value="@ps.SongId" />
                        <button class="btn btn-sm btn-outline-danger">Șterge</button>
                    </form>
                }

            </div>

        </div>
    }
}
else
{
    <p><em>There are no songs in the playlist.</em></p>
}

@if (ViewBag.AddSongMessage != null)
{
    var msg = ViewBag.AddSongMessage.ToString();

    if (msg.Contains("există deja"))
    {
        <div class="alert alert-warning">@msg</div>
    }
    else
    {
        <div class="alert alert-success">@msg</div>
    }
}

@if (ViewBag.AfisareButoane == true)
{
    <hr />
    <h5>Add song</h5>

    <form asp-action="AddSong" method="post">
        <input type="hidden" name="playlistId" value="@Model.Id" />

        <select name="songId" class="form-select mb-2">
            @foreach (var s in ViewBag.Songs)
            {
                <option value="@s.Value">@s.Text</option>
            }
        </select>

        <button type="submit" class="btn btn-primary">Add</button>
    </form>
}

<br />
<a asp-action="Index" class="btn btn-secondary">Back</a>


            <script>
            function togglePlaylistPlay(id) {
                var audio = document.getElementById("audio-playlist-" + id);
                var icon = document.getElementById("icon-playlist-" + id);

                if (!audio || !icon) return;

                if (audio.paused) {

                    // Oprim orice altă melodie din playlist
                    document.querySelectorAll("audio[id^='audio-playlist-']").forEach(a => {
                        if (a !== audio) {
                            a.pause();
                            a.currentTime = 0;

                            let otherId = a.id.replace("audio-playlist-", "");
                            let otherIcon = document.getElementById("icon-playlist-" + otherId);
                            if (otherIcon) {
                                otherIcon.classList.remove("bi-pause-fill");
                                otherIcon.classList.add("bi-play-fill");
                            }
                        }
                    });

                    audio.play();
                    icon.classList.remove("bi-play-fill");
                    icon.classList.add("bi-pause-fill");
                } else {
                    audio.pause();
                    icon.classList.remove("bi-pause-fill");
                    icon.classList.add("bi-play-fill");
                }
            }
        </script>
