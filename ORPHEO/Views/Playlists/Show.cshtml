@model Orpheo.Models.Playlist

@{
    ViewData["Title"] = Model.Name;
}

<!-- ALERT (pentru EDIT / ADD / DELETE playlist) -->
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}

<!-- TITLE -->
<h2 class="orpheo-page-title mb-1">
    @Model.Name
    @if (Model.IsPublic)
    {
        <i class="bi bi-unlock ms-1" title="Public playlist"></i>
    }
    else
    {
        <i class="bi bi-lock ms-1" title="Private playlist"></i>
    }
</h2>
<br />
<!-- OWNER -->
<div class="user-inline mb-4">
    <img src="@(Model.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
         class="user-avatar" />
    <small>@Model.User?.Name</small>
</div>

<!-- ACTIONS -->
@if (ViewBag.AfisareButoane == true)
{
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-orpheo">
            <i class="bi bi-pencil-square"></i> Edit
        </a>

        <a asp-controller="Playlists"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn-cancel">
            <i class="bi bi-trash me-1"></i>Delete
        </a>

    </div>
}

<hr />

<!-- SEARCH -->
<form method="get" class="mb-4">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="text"
           name="search"
           value="@ViewBag.Search"
           class="form-control orpheo-input"
           placeholder="Search a song..." />
</form>

<!-- SEARCH RESULT -->
@if (ViewBag.JustSearched == true)
{
    if (ViewBag.FoundSongTitle != null)
    {
        <div class="orpheo-alert alert-success">
            <strong>@ViewBag.FoundSongTitle </strong>&nbsp; is in this playlist
        </div>
    }
    else
    {
        <div class="orpheo-alert alert-danger">
            The song &nbsp;<strong> @ViewBag.Search </strong>&nbsp; is not in this playlist
        </div>
    }
}

<h4 class="mt-4 mb-3">Songs in playlist</h4>

<!-- SONGS -->
@if (Model.PlaylistSongs.Any())
{
    @foreach (var ps in Model.PlaylistSongs)
    {
        var song = ps.Song;

        <div class="orpheo-card p-3 mb-3 d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">@song.Title</h5>

                <div class="user-inline">
                    <img src="@(song.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                         class="user-avatar" />
                    <strong>@song.User?.Name</strong>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button"
                        class="btn-orpheo-play"
                        onclick="togglePlaylistPlay(@ps.SongId)">
                    <i id="icon-playlist-@ps.SongId" class="bi bi-play-fill"></i>
                </button>

                <audio id="audio-playlist-@ps.SongId" src="@song.Url"></audio>

                @if (ViewBag.AfisareButoane == true)
                {
                    <form asp-action="RemoveSong" method="post">
                        <input type="hidden" name="playlistId" value="@Model.Id" />
                        <input type="hidden" name="songId" value="@ps.SongId" />
                        <button class="btn-cancel btn-sm">Remove</button>
                    </form>
                }
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">
        <em>There are no songs in this playlist.</em>
    </p>
}

<!-- ADD SONG -->
@if (ViewBag.AfisareButoane == true)
{
    <hr />
    <h5 class="mb-3">Add song</h5>

    <form asp-action="AddSong" method="post" class="d-flex gap-3">
        <input type="hidden" name="playlistId" value="@Model.Id" />

        <select name="songId" class="form-select orpheo-select">
            @foreach (var s in ViewBag.Songs)
            {
                <option value="@s.Value">@s.Text</option>
            }
        </select>

        <button type="submit" class="btn-orpheo">
            Add
        </button>
    </form>
}

<br />

<a asp-action="Index" class="btn-cancel mt-4">
    Back to playlists
</a>

<!-- PLAYER SCRIPT -->
<script>
    function togglePlaylistPlay(id) {
        const audio = document.getElementById("audio-playlist-" + id);
        const icon = document.getElementById("icon-playlist-" + id);

        document.querySelectorAll("audio[id^='audio-playlist-']").forEach(a => {
            if (a !== audio) {
                a.pause();
                a.currentTime = 0;
                const otherIcon = document.getElementById("icon-playlist-" + a.id.replace("audio-playlist-", ""));
                if (otherIcon) {
                    otherIcon.classList.remove("bi-pause-fill");
                    otherIcon.classList.add("bi-play-fill");
                }
            }
        });

        if (audio.paused) {
            audio.play();
            icon.classList.replace("bi-play-fill", "bi-pause-fill");
        } else {
            audio.pause();
            icon.classList.replace("bi-pause-fill", "bi-play-fill");
        }
    }
</script>
