@model Orpheo.Models.Playlist

<h2>Editează playlist</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    @if (Model.ImagePath != null)
    {
        <img src="@Model.ImagePath" style="width: 150px; border-radius: 10px;" class="mb-2" />
    }

    <input type="hidden" asp-for="ImagePath" />

    <div class="mb-3">
        <label class="form-label">Change playlist image</label>
        <input class="form-control" type="file" name="ImageFile" />
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" asp-for="IsPublic" />
        <label class="form-check-label" for="IsPublic">Public playlist</label>
    </div>
    

    <br />

    <button class="btn btn-primary">Salvează</button>
</form>
