@model Orpheo.Models.Playlist

@{
    ViewData["Title"] = "Edit playlist";
}

<h2 class="orpheo-page-title mb-4">Edit playlist</h2>

<!-- ALERT -->
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data"
      class="orpheo-form">

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImagePath" />

    <!-- NAME -->
    <div class="mb-4">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control orpheo-input" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <!-- CURRENT IMAGE -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="mb-4">
            <label class="form-label d-block">Current image</label>
            <img src="@Model.ImagePath"
                 style="width:160px; height:160px; object-fit:cover; border-radius:16px;"
                 class="shadow-sm" />
        </div>
    }

    <!-- CHANGE IMAGE -->
    <div class="mb-4">
        <label class="form-label">Change playlist image</label>
        <input class="form-control orpheo-input" type="file" name="ImageFile" />
    </div>

    <!-- PUBLIC SWITCH -->
    <div class="form-check form-switch mb-4">
        <input class="form-check-input" type="checkbox" asp-for="IsPublic" />
        <label class="form-check-label">
            Public playlist
        </label>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex gap-3">
        <button type="submit" class="btn-orpheo">
            Save changes
        </button>

        <a asp-action="Show"
           asp-route-id="@Model.Id"
           class="btn-cancel">
            Cancel
        </a>
    </div>
</form>
