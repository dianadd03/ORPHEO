@model Orpheo.Models.Playlist

@{
    ViewData["Title"] = Model.Name;
}

<h2 class="orpheo-page-title mb-4">
    @Model.Name
</h2>

@if (!Model.PlaylistSongs.Any())
{
    <div class="orpheo-alert alert-danger">
        This playlist has no songs.
    </div>
    return;
}

<!-- PLAYER CARD -->
<div class="orpheo-card p-4 mb-4">

    <!-- CONTROLS -->
    <div class="d-flex align-items-center gap-3 mb-3">

        <!-- PLAY / PAUSE -->
        <button class="btn-orpheo-play" id="playPauseBtn">
            <i class="bi bi-play-fill" id="playIcon" style="font-size:28px;"></i>
        </button>

        <!-- PREV -->
        <button class="btn-cancel" id="prevBtn">
            <i class="bi bi-skip-start-fill"></i>
        </button>

        <!-- NEXT -->
        <button class="btn-cancel" id="nextBtn">
            <i class="bi bi-skip-end-fill"></i>
        </button>

        <!-- CURRENT SONG -->
        <span id="currentSong" class="ms-3 fw-bold"></span>
    </div>

    <!-- PROGRESS -->
    <input type="range"
           id="progressBar"
           min="0"
           max="100"
           value="0"
           class="form-range" />

    <audio id="audioPlayer"></audio>
</div>

<!-- SONG LIST -->
<h4 class="mb-3">Songs in this playlist</h4>

<div class="d-flex flex-column gap-2">
    @foreach (var ps in Model.PlaylistSongs)
    {
        <div class="orpheo-card d-flex justify-content-between align-items-center p-3 song-item"
             data-url="@ps.Song.Url"
             data-title="@ps.Song.Title">

            <span class="fw-medium">@ps.Song.Title</span>

            <button class="btn-orpheo-play playThisBtn">
                <i class="bi bi-play-fill"></i>
            </button>
        </div>
    }
</div>
<br />
<a asp-action="Index" class="btn-cancel mt-4">
    ← Back to playlists
</a>

<!-- PLAYER SCRIPT -->
<script>
    const player = document.getElementById("audioPlayer");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const playIcon = document.getElementById("playIcon");
    const currentSongLabel = document.getElementById("currentSong");
    const progressBar = document.getElementById("progressBar");
    const nextBtn = document.getElementById("nextBtn");
    const prevBtn = document.getElementById("prevBtn");

    const songs = Array.from(document.querySelectorAll(".song-item")).map(item => ({
        url: item.dataset.url,
        title: item.dataset.title
    }));

    let index = 0;

    function loadSong(i) {
        index = i;
        player.src = songs[i].url;
        currentSongLabel.innerText = songs[i].title;
        player.play();
        playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
    }

    playPauseBtn.onclick = () => {
        if (player.paused) {
            player.play();
            playIcon.classList.replace("bi-play-fill", "bi-pause-fill");
        } else {
            player.pause();
            playIcon.classList.replace("bi-pause-fill", "bi-play-fill");
        }
    };

    nextBtn.onclick = () => {
        index = (index + 1) % songs.length;
        loadSong(index);
    };

    prevBtn.onclick = () => {
        index = (index - 1 + songs.length) % songs.length;
        loadSong(index);
    };

    player.onended = () => {
        index = (index + 1) % songs.length;
        loadSong(index);
    };

    player.ontimeupdate = () => {
        if (!isNaN(player.duration)) {
            progressBar.value = (player.currentTime / player.duration) * 100;
        }
    };

    progressBar.oninput = () => {
        player.currentTime = (progressBar.value / 100) * player.duration;
    };

    document.querySelectorAll(".playThisBtn").forEach((btn, i) => {
        btn.onclick = () => loadSong(i);
    });

    loadSong(0);
</script>
