@using Orpheo.Models

@{
    ViewData["Title"] = "Playlists";
    var playlists = ViewBag.Playlists as IEnumerable<Playlist>;
}

<h2 class="orpheo-page-title mb-3">Playlists</h2>

<!-- ALERT (TempData, stil Orpheo) -->
@if (TempData["message"] != null)
{
    <div class="orpheo-alert @TempData["messageType"]">
        @TempData["message"]
    </div>
}

<br />

@if (User.Identity.IsAuthenticated)
{
    <a asp-action="New" class="btn-orpheo mb-4">
        + Create playlist
    </a>
}
<br />
<br />
<br />


<div class="row row-cols-1 row-cols-md-3 g-4">

    @foreach (var p in playlists)
    {
        <div class="col">
            <div class="orpheo-card h-100">

                <!-- IMAGE -->
                <img src="@(string.IsNullOrEmpty(p.ImagePath)
                                                 ? "/uploads/playlists/default.jpg"
                                                 : p.ImagePath)"
                 class="w-100"
                 style="height:220px;
                            object-fit:cover;
                            border-radius:16px 16px 0 0;" />

                <!-- BODY -->
                <div class="p-3">

                    <!-- TITLE -->
                    <h5 class="mb-1">
                        @p.Name
                    @if (p.IsPublic)
                        {
                            <i class="bi bi-unlock ms-1" title="Public playlist"></i>
                        }
                        else
                        {
                            <i class="bi bi-lock ms-1" title="Private playlist"></i>
                        }
                    </h5>

                    <!-- USER -->
                    <div class="user-inline mb-2">
                        <img src="@(p.User?.ProfileImage ?? "/uploads/profile-images/default.png")"
                             class="user-avatar"
                             alt="user avatar" />
                        <small>@p.User?.Name</small>
                    </div>

                    <!-- SONG COUNT -->
                    <small class="text-muted">
                        🎵 @p.PlaylistSongs.Count() songs
                    </small>

                    <!-- ACTIONS -->
                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="Show"
                           asp-route-id="@p.Id"
                           class="btn-orpheo w-100">
                            Open
                        </a>

                        <a asp-action="Play"
                           asp-route-id="@p.Id"
                           class="btn-cancel w-100">
                            Play
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@if (!User.Identity.IsAuthenticated)
{
    <p class="text-muted mt-4">
        You must be logged in to create a playlist.
    </p>
}
