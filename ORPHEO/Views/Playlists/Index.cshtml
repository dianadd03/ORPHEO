@using Orpheo.Models

@{
    var playlists = ViewBag.Playlists as IEnumerable<Playlist>;
}

<h2>Lista playlisturilor</h2>

@if (User.Identity.IsAuthenticated)
{
    <a asp-action="New" class="btn btn-primary mb-3">Creează playlist</a>
}

@if (ViewBag.Message != null)
{
    <div class="alert @ViewBag.AlertType">@ViewBag.Message</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var p in playlists)
    {
        <div class="col">
            <div class="card shadow-sm" style="border-radius: 12px;">

                <img src="@(string.IsNullOrEmpty(p.ImagePath)
                                 ? "/uploads/playlists/default.jpg"
                                 : p.ImagePath)"
                     class="card-img-top"
                     style="height: 250px; object-fit: cover; border-radius: 12px 12px 0 0;" />

                <div class="card-body">
                    <a class="btn btn-primary" asp-action="Play" asp-route-id="@p.Id">
                        Play playlist
                    </a>


                    <h5 class="card-title">
                        @p.Name
                        @if (p.IsPublic)
                        {
                            <i class="bi bi-unlock" title="Public playlist"></i>
                        }
                        else
                        {
                            <i class="bi bi-lock" title="Private playlist"></i>
                        }
                    </h5>

                    <p class="card-text">
                        <strong>User:</strong> @p.User?.UserName <br />
                        <strong>Songs:</strong> @p.PlaylistSongs?.Count()
                    </p>

                    <a asp-action="Show" asp-route-id="@p.Id" class="btn btn-primary w-100">
                        Open playlist
                    </a>

                </div>
            </div>
        </div>
    }
</div>


@if (!User.Identity.IsAuthenticated)
{
    <i>Trebuie sa te loghezi pentru a putea crea un playlist.</i>
}
